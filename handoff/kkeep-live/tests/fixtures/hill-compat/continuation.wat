(module
  (type $call (func (param i32) (result i32)))
  (import "env" "pause" (func $pause (param i32) (result i32)))
  (memory (export "memory") 64 128)
  (global $heap (mut i32) (i32.const 1024))
  (global $stack (mut i32) (i32.const 4000000))
  (table 1 funcref)
  (elem (i32.const 0) $inner)
  (func (export "malloc") (param $size i32) (result i32) (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (global.get $heap) (local.get $size)))
    (local.get $p))
  (func (export "free") (param i32))
  (func (export "_emscripten_stack_restore") (param $p i32) (global.set $stack (local.get $p)))
  (func (export "_emscripten_stack_alloc") (param $n i32) (result i32)
    (global.set $stack (i32.sub (global.get $stack) (local.get $n))) (global.get $stack))
  (func $inner (param $id i32) (result i32) (local $value i32)
    (local.set $value (i32.add (local.get $id) (i32.const 10)))
    (i32.add (local.get $value) (call $pause (local.get $id))))
  (func $entry (export "__main_argc_argv") (export "hcr_thread_start") (param $id i32) (result i32)
    (local $saved i32) (local $first i32) (local $second i32)
    (local.set $saved (global.get $stack))
    (global.set $stack (i32.sub (global.get $stack) (i32.const 16)))
    (i32.store (global.get $stack) (i32.add (local.get $id) (i32.const 100)))
    (local.set $first (call_indirect (type $call) (local.get $id) (i32.const 0)))
    (local.set $second (call $pause (i32.add (local.get $id) (i32.const 20))))
    (local.set $second (i32.add (local.get $second) (i32.load (global.get $stack))))
    (global.set $stack (local.get $saved))
    (i32.add (local.get $first) (local.get $second)))
  (func (export "hcr_ev_touch") (param $v i32) (result i32)
    (i32.add (local.get $v) (i32.const 1)))
)
